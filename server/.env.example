NODE_ENV=development
PORT=3000

# Required
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=replace-with-strong-random-secret
# Random 32-byte hex key. Back up securely; losing it makes encrypted Telegram sessions unreadable.
SESSION_ENCRYPTION_KEY=
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace-with-telegram-api-hash
TELEGRAM_SESSION=
# Optional dedicated storage account (recommended for public shares)
TELEGRAM_STORAGE_SESSION=
TELEGRAM_STORAGE_CHAT_ID=me
ALLOW_LEGACY_STORAGE_READS=false
# Required for durable upload recovery on your deployment: absolute path on a persistent disk.
UPLOAD_STORAGE_DIR=./data/uploads
UPLOAD_MAX_FILE_SIZE_BYTES=1073741824

# Required in production
COOKIE_SECRET=replace-with-strong-cookie-secret

# Recommended
ALLOWED_ORIGINS=https://axya-web-ih1c.onrender.com,http://localhost:3000,http://localhost:3001,http://localhost:8081

# Optional share/space overrides
SERVER_BASE_URL=https://axya-cloud-zxjk.onrender.com
FRONTEND_BASE_URL=https://axya-web-ih1c.onrender.com
SHARE_PUBLIC_BASE_URL=https://axya-web-ih1c.onrender.com
WEB_PUBLIC_BASE_URL=https://axya-web-ih1c.onrender.com
SHARE_LINK_SECRET=
SHARE_ACCESS_SECRET=
SHARE_ACCESS_TOKEN_TTL=12h
# Required for production; development can use the existing JWT fallback.
SHARE_V2_SESSION_SECRET=
SHARE_V2_TICKET_SECRET=
SHARE_V2_LINK_PEPPER=
SHARE_V2_TICKET_TTL_SECONDS=600
SHARE_V2_META_CACHE_TTL_SECONDS=20
SHARE_V2_LOOKUP_CACHE_TTL_SECONDS=20
SHARE_V2_ITEMS_CACHE_TTL_SECONDS=12
HEALTH_DB_TIMEOUT_MS=1200
SPACE_ACCESS_SECRET=
SIGNED_DOWNLOAD_SECRET=
SHARED_SPACE_MAX_UPLOAD_BYTES=209715200
STORAGE_QUOTA_ENABLED=false
