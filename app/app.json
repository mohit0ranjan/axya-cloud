{
  "expo": {
    "name": "Axya",
    "slug": "axya",
    "scheme": "axya",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F8FAFF",
      "image": "./assets/transparent.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mohit.axya",
      "associatedDomains": [
        "applinks:axyzcloud.com",
        "applinks:axya-web-ih1c.onrender.com"
      ],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Axya needs access to save files to your library.",
        "NSPhotoLibraryAddUsageDescription": "Axya saves downloaded files to your Photos.",
        "NSDocumentPickerUsageDescription": "Axya needs to access files you want to upload.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.mohit.axya",
      "versionCode": 5,
      "permissions": [
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "USE_BIOMETRIC",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#4B6EF5",
        "foregroundImage": "./assets/icon-foreground.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "axyzcloud.com"
            },
            {
              "scheme": "https",
              "host": "axya-web-ih1c.onrender.com"
            }
          ]
        },
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "*/*"
            }
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "*/*"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/6f616215-0dfa-43cd-a895-32751f6864d9"
    },
    "plugins": [
      "expo-updates",
      "expo-sharing",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/axya_logo.png",
          "color": "#4B6EF5",
          "sounds": []
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "javaVersion": "17"
          }
        }
      ],
      "./plugins/with-android-gradle-tuning",
      [
        "expo-audio",
        {
          "microphonePermission": "Axya uses your microphone when you record a voice note."
        }
      ],
      "expo-image",
      "expo-secure-store",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf",
      [
        "expo-media-library",
        {
          "photosPermission": "Axya backs up photos only from the album you choose.",
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "owner": "mohit5051",
    "extra": {
      "eas": {
        "projectId": "6f616215-0dfa-43cd-a895-32751f6864d9"
      }
    }
  }
}
